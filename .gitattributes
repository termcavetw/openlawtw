# Auto detect text files and perform LF normalization
* text=auto

# Official downloaded snapshots are checked against their original byte hashes.
# Preserve mixed line endings on every platform instead of normalizing them.
data/documents/*-source.html -text

# Version archives are content-addressed; their filenames hash the exact bytes.
data/versions/** -text

# Official HTML regression fixtures also retain exact downloaded bytes.
scripts/tests/fixtures/** -text

# Source evidence hashes refer to exact downloaded bytes.
data/documents/article-figures/**/source.html -text

# Green-building publication evidence hashes also require original HTML bytes.
data/formal-sources/green-building/*.html -text -diff
# Supplement attachment/source evidence hashes refer to exact downloaded bytes.
data/documents/article-supplements/sources/** -text -diff
